{
  // Cloudflare Workers settings for ev-srbija.rs
  // The website is the "site" folder; nothing is built on Cloudflare (no build command).
  "name": "ev-srbija",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    // addresses without .html: /modeli is served from modeli.html, /modeli.html redirects to /modeli,
    // / is served from index.html
    "html_handling": "auto-trailing-slash",
    // unknown addresses show site/404.html with status 404
    "not_found_handling": "404-page"
  }
}
