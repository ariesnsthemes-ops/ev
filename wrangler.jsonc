{
  // Cloudflare Workers settings for evomobil.rs (the name must match the Worker in Cloudflare: "ev")
  // Cloudflare runs "npm run build" (Astro), which writes the "site" folder; "npx wrangler deploy" then publishes it.
  "name": "ev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    // addresses without .html: /modeli is served from modeli.html, /modeli.html redirects to /modeli,
    // / is served from index.html
    "html_handling": "auto-trailing-slash",
    // unknown addresses show site/404.html with status 404
    "not_found_handling": "404-page"
  },
  // branch previews (the "astro" branch etc.): Cloudflare runs "npx wrangler preview", which needs this block;
  // the previews use the same assets and settings as above
  "previews": {}
}
