---
/**
 * Site header. `pre` is the path prefix back to the site root ('' , '../' or '/');
 * on the homepage the brand and "Pronađi automobil" links point at anchors on the page itself.
 */
interface Props { pre?: string; isHome?: boolean }
const { pre = '', isHome = false } = Astro.props;
const home = (hash?: string) => (isHome ? '#' + (hash ?? 'top') : (pre || './') + (hash ? '#' + hash : ''));
---
<header class="site">
  <div class="wrap nav">
    <a href={home()} class="brand" aria-label="evomobil.rs početna">
      <svg class="brand-mark" viewBox="0 0 175.57 91.84" aria-hidden="true"><path class="lg-e" fill="var(--logo-ink)" d="M105.99222,72.10025c-18.72322.00417-45.36337.00558-62.00185.01952a39.50018,39.50018,0,0,1-7.825-.70975c-8.52285-1.71391-15.18509-5.64747-17.86-14.10987-.68481-2.16651-.6615-2.17762,1.56385-2.17737,20.2844.002,42.657-.066,63.2557.057a11.17475,11.17475,0,0,0,7.807-3.11028L103.90247,39.621a.42794.42794,0,0,0-.29632-.73669H20.0763A29.08573,29.08573,0,0,1,30.21436,26.96842c9.39172-6.54645,20.04187-9.048,31.26038-9.14325,19.384-.16472,59.49393-.0913,64.66731-.081a1.37333,1.37333,0,0,0,.95663-.38552L144.07162,1.069a.12245.12245,0,0,0-.08355-.21164c-25.28735.03888-52.83876-.03045-78.10049.17885-13.51489.11194-26.56714,2.78833-38.561,9.26788C12.84046,18.13,2.76331,29.4943.3827,46.34641-1.63476,60.62833,4.40711,74.32316,16.55042,81.76633,24.93811,86.90738,34.21351,88.6522,43.804,88.7949c13.95375.20771,38.557.05232,52.82289.07332a.455.455,0,0,0,.3943-.22729l9.36142-15.8424A.45936.45936,0,0,0,105.99222,72.10025Z"/><defs><clipPath id="lg-clip"><path d="M175.00809,37.7372H142.29184a.56543.56543,0,0,1-.507-.81582L159.61474.82046a.56544.56544,0,0,0-.89886-.658L103.75415,53.00329a.56544.56544,0,0,0,.39188.97305h26.06361a.56544.56544,0,0,1,.4868.85309L109.33566,90.97828a.56544.56544,0,0,0,.84336.7265l65.18563-52.9633A.56543.56543,0,0,0,175.00809,37.7372Z"/></clipPath></defs><path class="lg-bolt" fill="#3aab18" d="M175.00809,37.7372H142.29184a.56543.56543,0,0,1-.507-.81582L159.61474.82046a.56544.56544,0,0,0-.89886-.658L103.75415,53.00329a.56544.56544,0,0,0,.39188.97305h26.06361a.56544.56544,0,0,1,.4868.85309L109.33566,90.97828a.56544.56544,0,0,0,.84336.7265l65.18563-52.9633A.56543.56543,0,0,0,175.00809,37.7372Z"/><g clip-path="url(#lg-clip)"><rect class="lg-lvl" x="100" y="0" width="80" height="92"/></g><circle class="lg-sp lg-s1" cx="160" cy="2" r="7" style="--dx:40px;--dy:-40px"/><circle class="lg-sp lg-s2" cx="170" cy="12" r="7" style="--dx:54px;--dy:-10px"/><circle class="lg-sp lg-s3" cx="110" cy="89" r="7" style="--dx:-40px;--dy:36px"/><circle class="lg-sp lg-s4" cx="104" cy="80" r="7" style="--dx:-54px;--dy:8px"/></svg>
      <span>evomobil<span class="tld">.rs</span></span>
    </a>
    <nav class="nav-links" id="nav-links" aria-label="Glavna navigacija">
      <a href={pre + "brendovi"}>Brendovi</a>
      <a href={pre + "modeli"}>Modeli</a>
      <a href={pre + "distributeri"}>Distributeri</a>
      <a href={pre + "punjaci"}>Punjači</a>
      <a href={pre + "kalkulator-troskova"}>Kalkulator</a>
      <a href={pre + "subvencije-elektricni-automobili-2026"}>Subvencije</a>
    </nav>
    <div class="nav-actions">
      <button class="theme-btn" id="theme-btn" type="button" aria-pressed="false" aria-label="Uključi tamnu temu" title="Uključi tamnu temu">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      </button>
      <a href={home("pretraga")} class="btn btn-dark nav-cta">Pronađi automobil</a>
      <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Otvori meni">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 5h14M2 9h14M2 13h14"/></svg>
      </button>
    </div>
  </div>
  <script is:inline>/* logo animation (the bolt charges from bottom to top and throws sparks, the E steps back):
     on mouse hover (desktop), and on a tap/click of the logo. A tap that opens the homepage plays it there, after the page loads. */
  (function(){var b=document.querySelector('header.site .brand'),K='evc-logo-play';if(!b||!window.matchMedia||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    var t;function play(){if(b.classList.contains('lg-play'))return;b.classList.add('lg-play');clearTimeout(t);t=setTimeout(function(){b.classList.remove('lg-play')},1700)}
    if(matchMedia('(hover:hover) and (pointer:fine)').matches)b.addEventListener('mouseenter',play);
    b.addEventListener('click',function(){var h=b.getAttribute('href')||'';if(h.charAt(0)==='#')play();else try{sessionStorage.setItem(K,'1')}catch(e){}});
    var go=null;try{go=sessionStorage.getItem(K);sessionStorage.removeItem(K)}catch(e){}
    if(go)setTimeout(play,250);
  })();
  </script>
  <script is:inline>
  /* light theme by default, whatever the visitor's system setting; dark only when chosen with the button */
  (function(){var r=document.documentElement,k='evc-theme-s',t=null;try{t=sessionStorage.getItem(k)}catch(e){}
    if(!t&&/SamsungBrowser/.test(navigator.userAgent)&&window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)t='dark';
    r.setAttribute('data-evtheme',t==='dark'?'dark':'light');
    function cs(d){var m=document.querySelector('meta[name=color-scheme]');if(m)m.content=r.classList.contains('sam')?'light dark':(d?'dark':'only light')}cs(t==='dark');
    var b=document.getElementById('theme-btn');
    function sync(){var d=r.getAttribute('data-evtheme')==='dark',l=d?'Uključi svetlu temu':'Uključi tamnu temu';b.setAttribute('aria-pressed',d);b.setAttribute('aria-label',l);b.title=l}
    sync();
    b.addEventListener('click',function(){var d=r.getAttribute('data-evtheme')!=='dark';r.setAttribute('data-evtheme',d?'dark':'light');cs(d);try{sessionStorage.setItem(k,d?'dark':'light')}catch(e){}sync()});
  })();
  </script>
</header>